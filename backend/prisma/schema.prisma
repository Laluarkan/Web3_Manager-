generator client {
  provider = "prisma-client-js"
}

// Lokal: gunakan "sqlite" dengan DATABASE_URL="file:./dev.db"
// Staging (Neon): ubah provider menjadi "postgresql" tanpa mengubah kode backend!
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  username          String
  passwordHash      String?
  googleId          String?    @unique
  walletAddress     String?    @unique
  walletNonce       String?
  hasClaimedStarter Boolean    @default(false)
  freeMatchWins     Int        @default(0)
  freeMatchPlayed   Int        @default(0)
  freeMatchPoints   Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  cards  UserCard[]
  lineup Lineup?
}

model Club {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  leagueName String
  country    String
  logoUrl    String?

  players Player[]
}

model Player {
  id             Int       @id @default(autoincrement())
  externalKey    String    @unique
  name           String
  nationality    String
  clubId         Int
  position       String    // GK | DF | MF | FW
  detailPosition String    // GK | LB | CB | RB | CDM | CM | CAM | LW | ST | RW
  overall        Int
  pace           Int
  shooting       Int
  passing        Int
  dribbling      Int
  defending      Int
  physical       Int
  liveForm       String    @default("C") // A | B | C | D | E
  appearances    Int       @default(0)
  goals          Int       @default(0)
  assists        Int       @default(0)
  saves          Int       @default(0)
  photoUrl       String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  club      Club       @relation(fields: [clubId], references: [id])
  userCards UserCard[]
}

model UserCard {
  id          String   @id @default(cuid())
  userId      String
  playerId    Int
  position    String   // GK | DF | MF | FW
  baseOverall Int
  level       Int      @default(1)
  rarity      String   @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY | MYTHIC
  edition     String   @default("BASE")   // BASE | POTW | HIGHLIGHT | CLUB_SELECTION | ICONIC
  season      Int      @default(2026)
  isOnChain   Boolean  @default(false)
  tokenId     Int?     @unique
  isListed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  player      Player          @relation(fields: [playerId], references: [id])
  lineupSlots LineupSlot[]
  listings    MarketListing[]
}

model Lineup {
  id        String       @id @default(cuid())
  userId    String       @unique
  formation String       @default("4-3-3")
  updatedAt DateTime     @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots LineupSlot[]
}

model LineupSlot {
  id         String @id @default(cuid())
  lineupId   String
  slotCode   String // GK, LB, LCB, RCB, RB, LCM, CM, RCM, LW, ST, RW
  userCardId String

  lineup   Lineup   @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  userCard UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@unique([lineupId, slotCode])
}

model MarketListing {
  id           String   @id @default(cuid())
  listingId    Int      @unique
  tokenId      Int
  userCardId   String?
  sellerWallet String
  buyerWallet  String?
  priceKans    String   // Disimpan sebagai string desimal agar presisi (misal "250")
  status       String   @default("ACTIVE") // ACTIVE | SOLD | CANCELED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userCard UserCard? @relation(fields: [userCardId], references: [id], onDelete: SetNull)
}
